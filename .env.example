# slskd API key: role=<role>;cidr=<allowed ranges>;<key>. jSeeker.sh generates this.
SLSKD_API_KEY=role=readwrite;cidr=172.16.0.0/12;<generated>

# Spotify app Client ID (developer.spotify.com/dashboard). Add http://127.0.0.1:8888/callback as a Redirect URI.
SPOTIFY_CLIENT_ID=

# TypeSafe API token for Jev. Optional: without it, files are matched by name only.
JEV_API_KEY=

# Optional: where your music library and slskd's data live on this machine.
# MUSIC_DIR=~/Music/DJLib
# SLSKD_DIR=~/slskd
