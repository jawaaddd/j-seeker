# Read by docker-compose.yml for slskd. j-seeker's own settings are in its config.toml.

# slskd API key: role=<role>;cidr=<allowed ranges>;<key>. Put the same key in j-seeker's config.toml.
SLSKD_API_KEY=role=readwrite;cidr=0.0.0.0/0;<a long random string>

# The user slskd runs as. On Linux, use your own (id -u / id -g) so the files it writes are yours.
# On Windows, use 0: Docker Desktop's mounts belong to your Windows account anyway, and as any other
# user slskd can't write to folders an earlier root container created.
# PUID=1000
# PGID=1000

# Optional: the port Soulseek peers connect to (default 50300). On Windows, Hyper-V often reserves
# ports around 50000 ("bind: ... forbidden by its access permissions"); 2234 is a safe choice there.
# SLSKD_LISTEN_PORT=2234

# Optional: where your music library and slskd's data live on this machine.
# MUSIC_DIR=~/Music/DJLib
# SLSKD_DIR=~/slskd
